# L2 testnet deployment env (example)

# Required
RPC_URL=https://your-l2-testnet-rpc
ACCOUNT=your_l2_foundry_account_name
# Optional override. If empty, script uses deployer address of ACCOUNT as ADMIN.
ADMIN=

# LayerZero endpoint on this chain (set if using real testnet endpoint)
# If omitted, DeployLZHarness.s.sol will deploy a local endpoint mock (not real cross-chain)
LZ_ENDPOINT=0xYourL2EndpointV2

# L1 endpoint id (destination eid for messages sent from this chain)
REMOTE_EID=40161

# Path where deploy script writes JSON output
OUTPUT_JSON=./deployments/lz-harness-l2.json
