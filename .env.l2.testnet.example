# L2 testnet deployment env (example)

# -----------------------------------------------------------------------------
# Harness vars (used by script/lz_harness/*.py)
# -----------------------------------------------------------------------------

# Required
RPC_URL=https://your-l2-testnet-rpc
ACCOUNT=your_l2_foundry_account_name
# Optional override. If empty, scripts use deployer address of ACCOUNT as ADMIN.
ADMIN=

# LayerZero endpoint on this chain (set if using real testnet endpoint)
# If omitted, DeployLZHarness.s.sol may deploy a local endpoint mock (not real cross-chain)
LZ_ENDPOINT=0xYourL2EndpointV2

# L1 endpoint id (destination eid for messages sent from this chain)
REMOTE_EID=40161

# LZ Executor options for lzReceive on destination
LZ_RECEIVE_GAS=200000
LZ_RECEIVE_VALUE=0

# Path where scripts write JSON output
OUTPUT_JSON=./deployments/lz-harness-l2.json

# -----------------------------------------------------------------------------
# L2 protocol deploy vars (used by script/deploy_l2.py + script/DeployL2.s.sol)
# -----------------------------------------------------------------------------

# Optional profile helper for --env behavior
ENV=testnet

# Optional Derive registry selector (defaults to --env if provided)
DERIVE_REGISTRY_PROFILE=testnet
# Optional explicit override (e.g. 901 testnet, 957 mainnet)
DERIVE_REGISTRY_CHAIN_ID=

# Optional market selector for auto-loading more addresses from registry files
# Example market file: lib/v2-matching/lib/v2-core/deployments/<chainId>/ETH.json
# Loads OPTION_ASSET, BASE_FEED, and WRAPPED_DEPOSIT_ASSET (from `base`)
DERIVE_MARKET=ETH

# L1 side counterpart addresses (if omitted, deploy_l2.py can derive from .env.l1.<env>)
L1_MESSENGER=
L1_VAULT=

# Optional explicit path to L1 deployment json (contains addrs.l1Messenger / addrs.l1Vault)
# L1_OUTPUT_JSON=./deployments/l1-testnet.json

# Optional override endpoint id expected from L1
L1_EID=40231

# Optional existing contracts (skip deploying mocks/new instances when set)
SOCKET_TRACKER=
LOAN_STORE=
TSA_PROXY=
TSA_IMPLEMENTATION=

# Optional explicit TSA init calldata (if empty and TSA_PROXY unset, script auto-encodes from fields below)
TSA_INIT_DATA=

# Optional TSA metadata
TSA_INITIAL_OWNER=
TSA_SYMBOL=cTSA
TSA_NAME=Collar TSA

# Auto-init required fields (when TSA_PROXY unset and TSA_INIT_DATA empty)
SUBACCOUNTS=
AUCTION=
CASH=
WRAPPED_DEPOSIT_ASSET=
MANAGER=
MATCHING=
BASE_FEED=
DEPOSIT_MODULE=
WITHDRAWAL_MODULE=
TRADE_MODULE=
RFQ_MODULE=
OPTION_ASSET=

# Optional verification settings
# VERIFIER=blockscout
# VERIFIER_URL=https://testnet-explorer.derive.xyz/api/
ETHERSCAN_API_KEY=
