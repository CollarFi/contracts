# L1 deployment env (example)

# Required
RPC_URL=https://your-l1-testnet-rpc
ACCOUNT=your_l1_foundry_account_name
TREASURY=0xYourTreasury

# Optional (if omitted, deploy runner derives from ACCOUNT foundry keystore address)
ADMIN=

# Output path for deployment JSON
OUTPUT_JSON=./deployments/l1-testnet.json

# Safe by default: keep false for simulation-only. Pass --broadcast to deploy_l1.py for live txs.
BROADCAST=false

# Optional overrides
VAULT_OWNER=
PERMIT2=0x000000000022D473030F116dDEE9F6B43aC78BA3
L2_RECIPIENT=

# Liquidity vault config:
# - Set LIQUIDITY_VAULT to reuse an existing vault; OR
# - Leave LIQUIDITY_VAULT empty and set USDC_ASSET to deploy a new CollarLiquidityVault.
LIQUIDITY_VAULT=
USDC_ASSET=0xYourUsdc

# Optional placeholder IEulerAdapter (if empty, script deploys EulerAdapterMock)
EULER_ADAPTER=

# LayerZero
LZ_ENDPOINT=0xYourL1EndpointV2

# Optional Socket WETH bridge config
WETH_ASSET=
WETH_SOCKET_VAULT=
WETH_SOCKET_BRIDGE=
WETH_SOCKET_CONNECTOR=
WETH_MSG_GAS_LIMIT=100000
WETH_PAYLOAD_SIZE=161

# Optional values consumed as fallback by script/deploy_l2.py
L1_MESSENGER=
L1_VAULT=
