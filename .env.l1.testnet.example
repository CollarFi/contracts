# L1 testnet deployment env (example)

# -----------------------------------------------------------------------------
# Harness vars (used by script/lz_harness/*.py)
# -----------------------------------------------------------------------------

# Required
RPC_URL=https://your-l1-testnet-rpc
ACCOUNT=your_l1_foundry_account_name
# Optional override. If empty, scripts use deployer address of ACCOUNT as ADMIN.
ADMIN=

# LayerZero endpoint on this chain (set if using real testnet endpoint)
# If omitted, DeployLZHarness.s.sol may deploy a local endpoint mock (not real cross-chain)
LZ_ENDPOINT=0xYourL1EndpointV2

# L2 endpoint id (destination eid for messages sent from this chain)
REMOTE_EID=40232

# LZ Executor options for lzReceive on destination
LZ_RECEIVE_GAS=200000
LZ_RECEIVE_VALUE=0

# Path where scripts write JSON output
OUTPUT_JSON=./deployments/lz-harness-l1.json

# -----------------------------------------------------------------------------
# Optional values consumed as fallback by script/deploy_l2.py
# (when --env testnet/mainnet is used)
# -----------------------------------------------------------------------------

# If set, deploy_l2.py can read these directly
L1_MESSENGER=
L1_VAULT=

# If L1_MESSENGER/L1_VAULT are empty, deploy_l2.py can parse OUTPUT_JSON
# expecting addrs.l1Messenger / addrs.l1Vault
