# L2 testnet deployment env for script/deploy_lz_harness_e2e.sh
# Fill all placeholders before running.

RPC_URL=https://testnet-rpc.derive.xyz/
ACCOUNT=CDPDeployer
# Optional override. If empty, script uses deployer address of ACCOUNT as ADMIN.
ADMIN=

# Real LayerZero endpoint on L2 testnet
LZ_ENDPOINT=0x6C7Ab2202C98C4227C5c46f1417D81144DA716Ff

# Destination EID (L1)
REMOTE_EID=40161

OUTPUT_JSON=./deployments/lz-harness-l2.json
